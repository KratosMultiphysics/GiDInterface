<?xml version="1.0" encoding="utf-8"?>
<container n="Utilities" pn="Utilities" icon="icon_utilities" help="Utilities" state="normal" open_window="0">

    <container n="Construction" pn="Construction" un="DamConstructionProcess" icon="solution16" help="Solution" state="normal" open_window="0">
        <value n="Activate_construction" pn="Activate construction process" un="DamActivateConstruction" v="No" values="Yes,No" actualize_tree="1"/>
        <container n="activateParts" pn="Activate existing parts" un="DamActivateParts" state="[activatePartsState]" actualize_tree="1" open_window="0" >
            <value n="activate_soil_part" pn="Activate soil part" un="DamActivateSoilPart" v="No" values="Yes,No" state="[HideIfUniqueName DamActivateConstruction No]" actualize_tree="1"/>
            <value n="name_soil_part" pn="Name soil part" v="" values="[GetParts]" help="Select the soil part" state="[HideIfUniqueName DamActivateSoilPart No]"/>
            <value n="activate_existing_part" pn="Activate existing dam part" un="DamActivateExistingPart" v="No" values="Yes,No" state="[HideIfUniqueName DamActivateConstruction No]" actualize_tree="1"/>
            <value n="name_existing_part" pn="Name existing part" v="" values="[GetParts]" help="Select the existing part" state="[HideIfUniqueName DamActivateExistingPart No]"/>
        </container >
        <container n="checkTemperature" pn="Check temperature" un="DamCheckTemperature" state="[checkTemperatureState]" actualize_tree="1" open_window="0" >
            <value n="activate_check_temperature" pn="Activate check temperature utility" un="DamActivateCheckTemperature" v="No" values="Yes,No" state="[HideIfUniqueName DamActivateConstruction No]" actualize_tree="1"/>
            <value n="maximum_temperature_increment" pn="Maximum temperature increment" v="0" state="[HideIfUniqueName DamActivateCheckTemperature No]"/>
            <value n="maximum_temperature" pn="Maximum temperature" v="0" state="[HideIfUniqueName DamActivateCheckTemperature No]"/>
            <value n="minimum_temperature" pn="Minimum temperature" v="0" state="[HideIfUniqueName DamActivateCheckTemperature No]"/>
        </container >
        <value n="gravity_direction" pn="Gravity direction" v="Z" values="X,Y,Z"  state="[HideIfUniqueName DamActivateConstruction No]"/>
        <value n="reservoir_bottom_coordinate_in_gravity_direction" pn="Reservoir Bottom Coordinate in Gravity Direction" v="0.0"  state="[HideIfUniqueName DamActivateConstruction No]"/>
        <value n="lift_height" pn="Lift height" v="0.0" help="Height of each lift" state="[HideIfUniqueName DamActivateConstruction No]"/>
        <value n="construction_input_file_name" pn="Name of Construction File" v="construction.txt" help="Please copy your file at current directory" state="[HideIfUniqueName DamActivateConstruction No]"/>
        <value n="h_0" pn="Heat Transfer Coefficient" v="1.0" help="W/(m^2 ºC)" state="[HideIfUniqueName DamActivateConstruction No]"/>
        <value n="ambient_input_file_name" pn="Name of Ambient Temp File" v="ambient.txt" help="Please copy your file at current directory" state="[HideIfUniqueName DamActivateConstruction No]"/>
        <value n="aging" pn="Consider Aging" un="DamAging" v="No" values="Yes,No" help="If aging is considered, please select a nodal law" state="[HideIfUniqueName DamActivateConstruction No]"/>
        <value n="source_type" pn="Source Type" un="DamSourceType" v="Adiabatic" values="Adiabatic,NonAdiabatic" state="[HideIfUniqueName DamActivateConstruction No]" actualize_tree="1"/>
        <container n="noorzai" pn="Adiabatic Parameters" un="DamNoorzaiData" state="[noorzaiState]"  open_window="0" >
            <value n="density" pn="Density" v="2400.0" help="kg/m^3"/>
            <value n="specific_heat" pn="Specific Heat" v="1000.0" help="J/(KgºC)" />
            <value n="alpha" pn="Alpha" v="8.47e-6" help="1/s" />
            <value n="tmax" pn="Maximum Temperature" v="18.0" help="The maximum temperature of concrete under adiabatic condition (ºC)" />
        </container>
        <container n="azenha" pn="Non-Adiabatic Parameters" un="DamAzenhaData" state="[azenhaState]" actualize_tree="1" open_window="0" >
            <value n="activation_energy" pn="Activation Energy" v="45507.0" help="J/mol"/>
            <value n="gas_constant" pn="Universal Constant" v="8.314472" help="J/(mol ºC)" />
            <value n="constant_rate" pn="Constant Rate" v="7.2237e10" help="W/m^3" />
            <value n="alpha_initial" pn="Initial Alpha" v="0.015" />
            <value n="q_total" pn="Q Total" v="6.7939e7" help="J/m^3"/>
            <value n="young_inf" pn="Final Young Modulus" state="[checkStateByUniqueName DamAging Yes]" v="2.0e10" help="Young Modulus reached once the curing is completed"/>
            <value n="A" pn="First Factor" v="0.4"/>
            <value n="B" pn="Second Factor" v="6.9"/>
            <value n="C" pn="Third Factor" v="27.0"/>
            <value n="D" pn="Fourth Factor" v="10.0"/>
        </container>
    </container>

    <container n="TransferResults" pn="Transfer results" un="DamTransferResults" icon="transfer_results" actualize_tree="1" open_window="0"
        help="Transfer the initial state between Dam calculations. Save/Load initial state read and write exact constitutive initial-state files (Gauss-point initial stresses plus nodal temperatures). Legacy result transfer maps nodal fields from previously saved .mdpa result files and is not equivalent to the exact constitutive-state transfer.">

        <container n="SaveInitialState" pn="Save initial state" un="DamSaveInitialStateContainer" help="Write a Dam initial-state file at the end of the analysis with the selected Gauss-point stresses and nodal temperatures. It can be enabled together with 'Load initial state'." actualize_tree="1" open_window="0">
            <value n="SaveInitialState" pn="Save initial state" un="DamSaveInitialState" v="No" values="Yes,No" actualize_tree="1" help="Write the selected initial-state fields when the analysis finishes"/>
            <container n="SaveInitialStateOptions" pn="Initial state to save" un="DamSaveInitialStateOptions" state="[HideIfUniqueName DamSaveInitialState No]" actualize_tree="1" open_window="0">
                <value n="Part" pn="Target part" un="DamSaveInitialStatePart" v="" values="[GetParts]" help="Structural part whose constitutive initial state is written. Only one Dam part is stored per initial-state file; other parts are not included."/>
                <value n="SaveInitialStresses" pn="Save initial stresses" un="DamSaveInitialStresses" v="Yes" values="Yes,No" actualize_tree="1" help="Save the initial stress state at the element Gauss points"/>
                <container n="InitialStressesOptions" pn="Initial stresses" un="DamSaveInitialStressesOptions" state="[HideIfUniqueName DamSaveInitialStresses No]" actualize_tree="1" open_window="0">
                    <value n="StressSource" pn="Stress source" un="DamInitialStateStressSource" v="current_cauchy" values="current_cauchy,stored_initial_stress" dict="current_cauchy,Current Cauchy stress,stored_initial_stress,Stored initial stress" help="Current Cauchy stress exports the current total Gauss-point Cauchy stresses (they may include gravity, thermal and other contributions). Stored initial stress exports the constitutive initial stresses currently stored in InitialState, which preserves previously imported stresses independently of later loading."/>
                </container>
                <value n="SaveInitialTemperature" pn="Save initial temperature" un="DamSaveInitialTemperature" v="Yes" values="Yes,No" actualize_tree="1" help="Save the nodal TEMPERATURE field"/>
                <value n="SaveReferenceTemperature" pn="Save reference temperature" un="DamSaveInitialReferenceTemperature" v="Yes" values="Yes,No" actualize_tree="1" help="Save the nodal NODAL_REFERENCE_TEMPERATURE field"/>
                <value n="OutputFile" pn="Output file" un="DamInitialStateOutputFile" v="initial_state.json.gz" help="Output path for the initial-state file. Use an absolute path, a path relative to the GiD project directory, or a filename. Supported extensions are .json and .json.gz. Parent folders are created automatically."/>
            </container>
        </container>

        <container n="AdditionalSaveInitialState" pn="Additional save entries" un="DamAdditionalSaveInitialState" help="Add one entry per additional structural part. The single 'Save initial state' section above is the first part; these entries are independent and may use different fields and output files." actualize_tree="1" open_window="0">
            <value n="Enable" pn="Define additional save entries" un="DamEnableAdditionalSave" v="No" values="Yes,No" actualize_tree="1" help="Enable repeatable save entries for additional structural parts"/>
            <container n="Entries" pn="Save entries" un="DamAdditionalSaveEntries" state="[HideIfUniqueName DamEnableAdditionalSave No]" actualize_tree="1" open_window="0">
                <blockdata n="SavePart" pn="Save part" name="Save part 1" sequence="1" editable_name="unique" can_delete_last_item="1">
                    <value n="Part" pn="Target part" values="[GetParts]" v=""/>
                    <value n="SaveInitialStresses" pn="Save initial stresses" v="Yes" values="Yes,No" actualize_tree="1"/>
                    <value n="StressSource" pn="Stress source" v="current_cauchy" values="current_cauchy,stored_initial_stress" dict="current_cauchy,Current Cauchy stress,stored_initial_stress,Stored initial stress" state="[getStateFromXPathValue {string(../value[@n='SaveInitialStresses']/@v)} Yes]"/>
                    <value n="SaveInitialTemperature" pn="Save initial temperature" v="Yes" values="Yes,No" actualize_tree="1"/>
                    <value n="SaveReferenceTemperature" pn="Save reference temperature" v="Yes" values="Yes,No" actualize_tree="1"/>
                    <value n="OutputFile" pn="Output file" v="additional_initial_state.json.gz" help="Unique output path for this part. Use .json or .json.gz. Different entries must not share the same output file."/>
                </blockdata>
            </container>
        </container>

        <container n="LoadInitialState" pn="Load initial state" un="DamLoadInitialStateContainer" help="Read selected fields from a Dam initial-state file before the first solution step. It can be enabled together with 'Save initial state'." actualize_tree="1" open_window="0">
            <value n="LoadInitialState" pn="Load initial state" un="DamLoadInitialState" v="No" values="Yes,No" actualize_tree="1" help="Apply the selected initial-state fields before the first solution step"/>
            <container n="LoadInitialStateOptions" pn="Initial state to load" un="DamLoadInitialStateOptions" state="[HideIfUniqueName DamLoadInitialState No]" actualize_tree="1" open_window="0">
                <value n="InputFile" pn="Input file" un="DamLoadInitialStateFile" type="file" v="- No file - (add files using File handler toolbar)" values="[GetTransferFileValues]" update_proc="AddFile" help="Initial-state file to read. Use the File handler toolbar to select an existing .json or .json.gz file, including files from other GiD projects. Selected files are copied into this project directory. An absolute path or a path relative to the GiD project directory can also be typed directly."/>
                <value n="Part" pn="Target part" un="DamLoadInitialStatePart" v="" values="[GetParts]" help="Structural part that receives the initial state. Its mesh, elements and materials must match the source file. Only this part is imported; other structural parts keep their own stress and temperature state, so a multi-part model may not be in global initial equilibrium."/>
                <value n="TransferInitialStresses" pn="Transfer initial stresses" un="DamTransferInitialStresses" v="Yes" values="Yes,No" actualize_tree="1" help="Assign the Gauss-point constitutive initial stresses stored in the file"/>
                <value n="TransferInitialTemperature" pn="Transfer initial temperature" un="DamTransferInitialTemperature" v="Yes" values="Yes,No" actualize_tree="1" help="Assign the nodal TEMPERATURE field stored in the file"/>
                <value n="TransferReferenceTemperature" pn="Transfer reference temperature" un="DamTransferInitialReferenceTemperature" v="Yes" values="Yes,No" actualize_tree="1" help="Assign the nodal NODAL_REFERENCE_TEMPERATURE field stored in the file. Cannot be combined with a reference-temperature condition that would overwrite it."/>
                <value n="ReferenceTemperaturePolicy" pn="Reference temperature policy" un="DamReferenceTemperaturePolicy" v="preserve" values="preserve,initial_temperature" dict="preserve,Preserve,initial_temperature,Use initial temperature as reference" help="Preserve keeps the imported TEMPERATURE and NODAL_REFERENCE_TEMPERATURE independent, which is recommended for staged construction and supports TEMPERATURE different from NODAL_REFERENCE_TEMPERATURE. Use initial temperature as reference explicitly resets NODAL_REFERENCE_TEMPERATURE to the imported TEMPERATURE; it requires transferring the initial temperature and cannot be combined with transferring the stored reference temperature."/>
            </container>
        </container>

        <container n="AdditionalLoadInitialState" pn="Additional load entries" un="DamAdditionalLoadInitialState" help="Add one entry per additional structural part. The single 'Load initial state' section above is the first part; these entries are independent and may use different fields and input files." actualize_tree="1" open_window="0">
            <value n="Enable" pn="Define additional load entries" un="DamEnableAdditionalLoad" v="No" values="Yes,No" actualize_tree="1" help="Enable repeatable load entries for additional structural parts"/>
            <container n="Entries" pn="Load entries" un="DamAdditionalLoadEntries" state="[HideIfUniqueName DamEnableAdditionalLoad No]" actualize_tree="1" open_window="0">
                <blockdata n="LoadPart" pn="Load part" name="Load part 1" sequence="1" editable_name="unique" can_delete_last_item="1">
                    <value n="Part" pn="Target part" values="[GetParts]" v=""/>
                    <value n="InputFile" pn="Input file" type="file" v="- No file - (add files using File handler toolbar)" values="[GetTransferFileValues]" update_proc="AddFile" help="Initial-state file for this part. Select a .json or .json.gz file with the File handler toolbar, or type an absolute/relative path."/>
                    <value n="TransferInitialStresses" pn="Transfer initial stresses" v="Yes" values="Yes,No" actualize_tree="1"/>
                    <value n="TransferInitialTemperature" pn="Transfer initial temperature" v="Yes" values="Yes,No" actualize_tree="1"/>
                    <value n="TransferReferenceTemperature" pn="Transfer reference temperature" v="Yes" values="Yes,No" actualize_tree="1"/>
                    <value n="ReferenceTemperaturePolicy" pn="Reference temperature policy" v="preserve" values="preserve,initial_temperature" dict="preserve,Preserve,initial_temperature,Use initial temperature as reference"/>
                </blockdata>
            </container>
        </container>

        <container n="RestartInitialStresses" pn="Restart initial stresses (checkpoint)" un="DamRestartInitialStressesContainer" help="Transfer Gauss-point initial stresses from a previous Kratos restart checkpoint (.rest) with the existing selective_initial_stress_process. This route transfers stresses only: it never transfers displacements, time, step counters, loads, TEMPERATURE or NODAL_REFERENCE_TEMPERATURE. Source and destination must use the same mesh, integration rule and validated constitutive laws. For thermoelastic laws, T must equal T_ref at the moment of import, so the reference field must already be assigned (for example by an active Nodal Reference Temperature condition)." actualize_tree="1" open_window="0">
            <value n="RestartInitialStresses" pn="Transfer stresses from restart checkpoint" un="DamRestartInitialStresses" v="No" values="Yes,No" actualize_tree="1" help="Enable the stress-only transfer from an existing Kratos .rest checkpoint"/>
            <container n="RestartInitialStressesOptions" pn="Restart stress transfer options" un="DamRestartInitialStressesOptions" state="[HideIfUniqueName DamRestartInitialStresses No]" actualize_tree="1" open_window="0">
                <value n="CheckpointFile" pn="Checkpoint file (.rest)" un="DamRestartInitialStressFile" type="file" v="- No file - (add files using File handler toolbar)" values="[GetTransferFileValues]" update_proc="AddFile" help="Select a Kratos restart file named &lt;model_part&gt;_&lt;label&gt;.rest, for example MainModelPart_1.0.rest. The file label is read from the file name. Files from other GiD projects can be selected with the File handler toolbar or referenced by an absolute/relative path."/>
                <value n="Part" pn="Target part" un="DamRestartInitialStressPart" v="" values="[GetParts]" help="Structural part that receives the checkpoint stresses. The source checkpoint must contain a matching part with the same mesh, integration rule and material, and 2D checkpoints must define THICKNESS. Only this part is transferred; other structural parts keep their own state."/>
                <value n="SourcePart" pn="Source part name" un="DamRestartInitialStressSourcePart" v="" help="Optional sub-model-part name inside the checkpoint (for example Parts_Concrete). Leave empty to use the target part name. The checkpoint root model part is expected to be MainModelPart."/>
            </container>
        </container>

        <container n="SaveResults" pn="Save results (legacy .mdpa)" un="DamSaveResults" help="Legacy workflow: write auxiliary .mdpa files with nodal displacement, nodal Cauchy stress, temperature and reference temperature. These files are consumed by the legacy mapping transfer and cannot be converted into an exact constitutive initial-state file." actualize_tree="1" open_window="0">
            <value n="SaveIntermediateResults" pn="Save Intermediate Results" un="DamSaveIntermediateResults" v="No" values="Yes,No" help="" actualize_tree="1"/>
            <value n="SaveIntermediateStep" pn="Step" un="DamSaveIntermediateStep" state="[checkStateByUniqueName DamSaveIntermediateResults Yes]" v="0" help="" actualize_tree="1"/>
            <value n="SaveFinalResults" pn="Save Final Results" un="DamSaveFinalResults" v="No" values="Yes,No" help="" actualize_tree="1"/>
        </container>

        <container n="PreviousResults" pn="Legacy result transfer (mapping)" un="DamPreviousResults" help="Legacy mapping from previously calculated Dam projects. It reads the .mdpa result files written by 'Save results (legacy .mdpa)', maps nodal DISPLACEMENT, nodal NODAL_CAUCHY_STRESS_TENSOR, TEMPERATURE and NODAL_REFERENCE_TEMPERATURE, and supports different meshes. It does not transfer the constitutive Gauss-point InitialState, so it is not equivalent to 'Load initial state'. It cannot be combined with 'Load initial state'." actualize_tree="1" open_window="0">
            <value n="AddPreviousResults" pn="Add previous results" un="DamAddPreviousResults" v="No" values="Yes,No" help="Enable the legacy nodal-field mapping from previous .mdpa result files" actualize_tree="1"/>
            <value n="TypeResults" pn="Type of results" un="DamTypeResults" v="Thermo-Mechanical" values="Mechanical,Thermal,Thermo-Mechanical" state="[HideIfUniqueName DamAddPreviousResults No]" help="" actualize_tree="1"/>
            <container n="AddResultsData" pn="Add data" un="DamAddResultsData" state="[addResultsState]" actualize_tree="1" open_window="0">
                <value n="DisplacementResults" pn="Displacement results" un="DamDisplacementResults" state="[HideIfUniqueName DamTypeResults Thermal]" v="No" values="Yes,No" help="" actualize_tree="1"/>
                <value n="StressResults" pn="Nodal cauchy stress results" un="DamStressResults" state="[HideIfUniqueName DamTypeResults Thermal]" v="No" values="Yes,No" help="Maps the nodal NODAL_CAUCHY_STRESS_TENSOR field. This is not the Gauss-point constitutive initial stress." actualize_tree="1"/>
                <value n="FileNameMechanical" pn="File name for mechanical results" un="DamFileMech" v="- No File -" state="[HideIfUniqueName DamTypeResults Thermal]" help="Legacy .mdpa file written by 'Save results (legacy .mdpa)'" actualize_tree="1"/>
                <value n="TemperatureResults" pn="Initial temperature results" un="DamInitialTempResults" state="[HideIfUniqueName DamTypeResults Mechanical]" v="No" values="Yes,No" help="" actualize_tree="1"/>
                <value n="RefTemperatureResults" pn="Nodal reference temperature results" un="DamRefTempResults" state="[HideIfUniqueName DamTypeResults Mechanical]" v="No" values="Yes,No" help="" actualize_tree="1"/>
                <value n="FileNameThermal" pn="File name for thermal results" un="DamFileTherm" v="- No File -" state="[HideIfUniqueName DamTypeResults Mechanical]" help="Legacy .mdpa file written by 'Save results (legacy .mdpa)'" actualize_tree="1"/>
            </container>
        </container>
    </container>

    <container n="Calibration" pn="Calibration" un="DamCalibration" icon="analysis" open_window="0">
	  <dynamicnode command="spdAux::injectConditions" args="TypeofCondition Calibration"/>
      <container n="MonitoringDevices" pn="Monitoring Devices"  icon="prdata16" help="Select your group" un="DamDevices">
          <value n="DeviceOutputState" pn="Device State" un="DamOutputState" v="False" values="True,False" actualize_tree="1"/>
          <blockdata n="device" pn="Device" name="Device 1" state="[HideIfUniqueName DamOutputState False]" sequence="1" editable_name="unique" help="Interval">
              <value n="Variable" pn="Variable" actualize_tree="1" v="DISPLACEMENT" values="DISPLACEMENT,TEMPERATURE" />
              <value n="XPosition" pn="X Position" actualize_tree="1" type="double" v="0.0" />
              <value n="YPosition" pn="Y Position" actualize_tree="1" type="double" v="0.0" />
              <value n="ZPosition" pn="Z Position" actualize_tree="1" type="double" v="0.0" />
          </blockdata>
      </container>
    </container>

    <container n="TemperatureDevice" pn="Temperature Device" ProcessName="ImposeTemperaturebyDeviceProcess" un="DamTempDevice" icon="temp_device" open_window="0">
        <value n="DeviceTemperatureState" pn="Device State" un="DamTemperatureState" v="False" values="True,False" actualize_tree="1"/>
        <blockdata n="device" pn="Device" name="Device 1" state="[HideIfUniqueName DamTemperatureState False]" sequence="1" editable_name="unique" help="Interval">
            <value n="constrained" pn="Imposed" actualize_tree="1" type="bool" v="true" values="true,false" />
            <value n="value" pn="Value" type="double" v="0.0" />
            <value n="table" pn="Temperature table filename" type="tablefile" v="" values = "[GetFilesValues]" update_proc = "AddFile" />
            <value n="XPosition" pn="X Position" actualize_tree="1" type="double" v="0.0" />
            <value n="YPosition" pn="Y Position" actualize_tree="1" type="double" v="0.0" />
            <value n="ZPosition" pn="Z Position" actualize_tree="1" type="double" v="0.0" />
        </blockdata>
    </container>

</container>
